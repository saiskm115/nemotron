# ─── Speech-to-text ─────────────────────────────────────────────────────
# Registry id of the default transcription model. See
# backend/providers/asr/registry.py for the full catalogue; every model can also
# be chosen per-session in the upload dialog.
#   svanita_0_6b | svanita_0_6b_telugu | indic_conformer_600m |
#   whisper_small_int8 | vasista22_whisper_telugu | whisper_large_v3 |
#   sarvam_saaras_v4
PRIMARY_ASR_MODEL=svanita_0_6b

# Svanita 0.6B (prasadvittaldev/svanita-0.6b). Full fp32 is deliberate: dynamic
# int8 costs roughly 30 WER points on this checkpoint. Set to 1 to forbid
# downloading and use only what is already in the local Hugging Face cache.
SVANITA_OFFLINE=0
SVANITA_THREADS=4

# IndicConformer 600M multilingual, all 22 scheduled Indian languages, INT8 ONNX.
# Runs through onnxruntime on CPU. Set INDIC_CONFORMER_PATH to use a copy that is
# already on disk instead of the Hugging Face cache, and INDIC_CONFORMER_OFFLINE=1
# to forbid downloading entirely. Decoding is "ctc" (fast, and the frame path is
# what word timestamps come from) or "rnnt".
INDIC_CONFORMER_PATH=
INDIC_CONFORMER_OFFLINE=0
INDIC_CONFORMER_THREADS=4
INDIC_CONFORMER_DECODER=ctc

# faster-whisper. WHISPER_DOWNLOAD_ONLINE=1 allows fetching model weights.
# WHISPER_VAD_FILTER=1 enables Whisper's own VAD chunking (off by default: on
# code-mixed Indian speech it triggers repetition loops).
WHISPER_DOWNLOAD_ONLINE=0
WHISPER_MODEL_SIZE=small
WHISPER_THREADS=4
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=0

# ─── Diarisation ───────────────────────────────────────────────────────
# Speaker embeddings for local diarisation. ECAPA-TDNN (the pyannote standard)
# is used when speechbrain is installed, with WavLM x-vector and then MFCC
# statistics as fallbacks. DIARIZATION_OFFLINE=1 forbids model downloads.
DIARIZATION_OFFLINE=0

# How many voices the result may contain. Diarisation backends treat this as a
# capacity rather than a prediction — Sortformer will label a two-voice call with
# all four of its classes if allowed to — so every result is re-clustered against
# measured speaker embeddings and this is a hard ceiling on that, not a guess.
DIARIZATION_MAX_SPEAKERS=8
# Floor. Set to 2 when a recording is known to be a two-handset call, so speaker
# count estimation is never allowed to report a single voice.
DIARIZATION_MIN_SPEAKERS=1

# NVIDIA Nemotron / Sortformer. Setting NEMOTRON_ENDPOINT routes diarisation to a
# remote service; installing nemo_toolkit enables local Sortformer instead.
NEMOTRON_ENDPOINT=
NEMOTRON_API_KEY=

# ─── Translation ────────────────────────────────────────────────────────
# Sarvam AI API key (translation)
SARVAM_API_KEY=
TRANSLATION_PROVIDER=sarvam
TRANSLATION_API_KEY=

# Sarvam AI API key (Saaras v4 cloud STT). Required only for the
# sarvam_saaras_v4 transcription model.
# SARVAM_API_KEY=

# ─── Storage ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/diarizestudio.db
STORAGE_PATH=./data/storage

# ─── Server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
